.form-grid .field > select { font-size: 12.5px }

.form-grid .field label { font-size: 12px; padding-top: 9px; }
.form-grid .field input[type="number"].qty-input { width: 74px; }

.form-grid .field-row label { font-size: 12px; }

.form-grid .field legend { font-size: 10.5px; padding-top: 0; }

.form-grid .field { --field-top-padding: 14px; }

.form-grid .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }

.form-grid .field-row field {  }

.form-grid .field-row.lg label { font-size: 11.5px; padding-top: 10px; }

.form-grid .field-row .form-grid .field label { font-size: 11px; padding-top: 8px; }
.form-grid .field-row .form-grid .field input { font-size: 11px; }

.form-grid .field-row .form-grid .field input[type="number"].qty-input { width: 74px; font-size: 11px; }

.form-grid .field-row .form-grid .field input { font-size: 11px; font-family: inherit; }

.form-grid .field-row .form-grid .field input.form-field-search { width: 100%; }

.form-grid .field-row .form-grid .field input.search-input { width: 100%; }

.form-grid .field-row .form-grid .field textarea.form-field { font-size: 11px; }

.form-grid .form-field textarea { font-size: 11px; }

.form-grid .field-row .form-grid .field textarea { font-size: 11px; }

.form-grid .field-row .form-grid .field textarea.form-field { font-size: 11px; }

.form-grid .field-row .form-grid .field input.form-field { font-size: 11px; }

.form-grid .field-row .form-grid .field input.form-field input { font-size: 11px; }

.form-grid .field-row .form-grid .field input.form-field-input { font-size: 11px; }

