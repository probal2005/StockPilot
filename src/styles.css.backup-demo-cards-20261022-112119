/* ==========================================================================
   StockPilot — "Aurora" theme
   Dark glass UI by default, light glass variant behind [data-theme="light"].
   All motion is driven by CSS transitions/keyframes and is disabled under
   prefers-reduced-motion.
   ========================================================================== */

:root,
:root[data-theme='dark'] {
  --bg: #05070f;
  --bg-2: #0a0f1e;
  --glow-a: rgba(99, 102, 241, 0.5);
  --glow-b: rgba(34, 211, 238, 0.35);
  --glow-opacity: 0.62;

  --surface: rgba(19, 26, 47, 0.72);
  --surface-solid: #121a2e;
  --line: rgba(148, 163, 184, 0.16);
  --line-soft: rgba(148, 163, 184, 0.09);

  --text: #e8ecf8;
  --text-2: #c3cbe0;
  --muted: #8a95af;

  --accent: #6366f1;
  --accent-2: #22d3ee;
  --accent-soft: rgba(99, 102, 241, 0.16);
  --accent-line: rgba(99, 102, 241, 0.42);

  --good: #34d399;
  --good-soft: rgba(52, 211, 153, 0.14);
  --warn: #fbbf24;
  --warn-soft: rgba(251, 191, 36, 0.14);
  --danger: #fb7185;
  --danger-soft: rgba(251, 113, 133, 0.14);

  --c1: #6366f1; --c2: #22d3ee; --c3: #f472b6; --c4: #34d399;
  --c5: #fbbf24; --c6: #a78bfa; --c7: #fb7185;

  --title-gradient: linear-gradient(100deg, #ffffff 0%, #cdd6ff 55%, #7dd3fc 100%);
  --shadow: 0 1px 2px rgba(0, 0, 0, 0.5), 0 12px 32px -18px rgba(0, 0, 0, 0.9);
  --shadow-lg: 0 30px 70px -20px rgba(0, 0, 0, 0.85);
  --glass-blur: 16px;
  --input-bg: rgba(9, 14, 27, 0.72);
  --scrim: rgba(3, 6, 15, 0.72);
  --tint: rgba(255, 255, 255, 0.045);
  --tint-strong: rgba(255, 255, 255, 0.08);

  --brand-navy: #dce7ff;   /* "STOCK" on a dark surface */
  --brand-blue: #4c8df6;   /* "PILOT" */
  --cyber-ink: #4c8df6;
  --cyber-opacity: 0.085;
  --cyber-grid: rgba(76, 141, 246, 0.075);
}

:root[data-theme='light'] {
  --bg: #eef1fa;
  --bg-2: #f7f9ff;
  --glow-a: rgba(99, 102, 241, 0.3);
  --glow-b: rgba(14, 165, 233, 0.24);
  --glow-opacity: 0.75;

  --surface: rgba(255, 255, 255, 0.78);
  --surface-solid: #ffffff;
  --line: rgba(15, 23, 42, 0.1);
  --line-soft: rgba(15, 23, 42, 0.055);

  --text: #0d1526;
  --text-2: #26314a;
  --muted: #626e88;

  --accent: #4f46e5;
  --accent-2: #0891b2;
  --accent-soft: rgba(79, 70, 229, 0.1);
  --accent-line: rgba(79, 70, 229, 0.32);

  --good: #059669;
  --good-soft: rgba(5, 150, 105, 0.12);
  --warn: #d97706;
  --warn-soft: rgba(217, 119, 6, 0.12);
  --danger: #e11d48;
  --danger-soft: rgba(225, 29, 72, 0.1);

  --c1: #4f46e5; --c2: #0891b2; --c3: #db2777; --c4: #059669;
  --c5: #d97706; --c6: #7c3aed; --c7: #e11d48;

  --title-gradient: linear-gradient(100deg, #0d1526 0%, #3730a3 60%, #0891b2 100%);
  --shadow: 0 1px 2px rgba(15, 23, 42, 0.06), 0 14px 30px -18px rgba(15, 23, 42, 0.35);
  --shadow-lg: 0 30px 60px -18px rgba(15, 23, 42, 0.32);
  --glass-blur: 14px;
  --input-bg: rgba(255, 255, 255, 0.88);
  --scrim: rgba(15, 23, 42, 0.42);
  --tint: rgba(15, 23, 42, 0.028);
  --tint-strong: rgba(15, 23, 42, 0.055);

  --brand-navy: #0a2a63;
  --brand-blue: #1e58ce;
  --cyber-ink: #1e58ce;
  --cyber-opacity: 0.07;
  --cyber-grid: rgba(30, 88, 206, 0.06);
}

:root {
  --sidebar: #070b16;
  --sidebar-2: #121a2e;
  --radius: 18px;
  --radius-sm: 11px;
  --mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
  --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
  --ease-soft: cubic-bezier(0.4, 0, 0.2, 1);
  color-scheme: dark;
}
:root[data-theme='light'] { color-scheme: light; }

* { box-sizing: border-box; }
html, body, #root { height: 100%; }

body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  font-size: 14px;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}

/* Drifting aurora blobs painted behind everything. */
body::before,
body::after {
  content: '';
  position: fixed;
  z-index: 0;
  pointer-events: none;
  width: 62vw;
  height: 62vw;
  border-radius: 50%;
  filter: blur(96px);
  opacity: var(--glow-opacity);
  will-change: transform;
}
body::before {
  top: -22vw; left: -12vw;
  background: radial-gradient(circle at 50% 50%, var(--glow-a), transparent 68%);
  animation: drift-a 30s var(--ease-soft) infinite alternate;
}
body::after {
  bottom: -28vw; right: -14vw;
  background: radial-gradient(circle at 50% 50%, var(--glow-b), transparent 68%);
  animation: drift-b 38s var(--ease-soft) infinite alternate;
}
@keyframes drift-a { from { transform: translate3d(0, 0, 0) scale(1); } to { transform: translate3d(9vw, 7vh, 0) scale(1.14); } }
@keyframes drift-b { from { transform: translate3d(0, 0, 0) scale(1.05); } to { transform: translate3d(-10vw, -8vh, 0) scale(0.95); } }

::selection { background: var(--accent); color: #fff; }

h1 {
  font-size: 26px; margin: 0 0 3px; letter-spacing: -0.03em; font-weight: 750;
  background: var(--title-gradient);
  -webkit-background-clip: text; background-clip: text; color: transparent;
  width: fit-content;
}
h2 { font-size: 15px; margin: 0; letter-spacing: -0.01em; font-weight: 650; }
h3 { font-size: 18px; margin: 0; letter-spacing: -0.02em; font-weight: 700; }
h4 { font-size: 12px; margin: 0; text-transform: uppercase; letter-spacing: 0.09em; color: var(--muted); font-weight: 650; }
p { margin: 0; }
ul { list-style: none; margin: 0; padding: 0; }
a { color: inherit; }

.muted { color: var(--muted); }
.small { font-size: 12px; }
.mono { font-family: var(--mono); font-size: 12.5px; }
.pos { color: var(--good); }
.neg { color: var(--warn); }
.error-text { color: var(--danger); }

/* ---------------------------------------------------------------- layout -- */

.app { display: grid; grid-template-columns: 256px 1fr; min-height: 100vh; position: relative; z-index: 1; }

.sidebar {
  background: linear-gradient(180deg, var(--sidebar) 0%, var(--sidebar-2) 100%);
  color: #cbd5e1;
  padding: 20px 14px;
  display: flex; flex-direction: column; gap: 22px;
  position: sticky; top: 0; height: 100vh;
  border-right: 1px solid rgba(148, 163, 184, 0.1);
  overflow: hidden;
}
.sidebar::after {
  content: ''; position: absolute; inset: 0; pointer-events: none;
  background: radial-gradient(600px 220px at 0% 0%, rgba(99, 102, 241, 0.22), transparent 70%);
}
.brand { display: flex; align-items: center; gap: 11px; padding: 0 6px; position: relative; z-index: 1; }
/* The logo is live SVG (src/brand.jsx) so it stays crisp at any size; these
   rules only size, light and place it. The mark always prints on its own light
   plate (`logo-chip`), which is what keeps it readable on the dark theme. */
.logo { display: inline-flex; align-items: center; gap: 12px; }
.logo-badge { flex: none; filter: drop-shadow(0 8px 20px rgba(10, 42, 99, 0.4)); transition: transform 0.4s var(--ease-out); }
.brand:hover .logo-badge { transform: translateY(-1px) scale(1.03); }
.logo-copy { display: flex; flex-direction: column; gap: 4px; line-height: 1; min-width: 0; }
.logo-word {
  display: flex; font-family: "Archivo Black", Montserrat, "Segoe UI", system-ui, sans-serif;
  font-weight: 800; font-size: 16px; letter-spacing: 0.055em; color: var(--brand-navy);
}
.logo-word-a { color: var(--brand-navy); }
.logo-word-b { color: var(--brand-blue); }
.logo-tagline { font-family: var(--mono); font-size: 8.5px; letter-spacing: 0.22em; color: var(--muted); }
.sidebar .logo-word-a { color: #eaf1ff; }
.sidebar .logo-word-b { color: #4c8df6; }
.sidebar .logo-tagline { color: #6f7d99; }

.sidebar nav { display: flex; flex-direction: column; gap: 4px; position: relative; z-index: 1; }
.nav-item {
  display: flex; align-items: center; gap: 11px; width: 100%;
  padding: 10px 12px; border-radius: 12px; border: 0; cursor: pointer;
  background: transparent; color: #b9c4d8; font: inherit; font-weight: 500; text-align: left;
  position: relative; isolation: isolate;
  transition: color 0.2s var(--ease-soft), transform 0.2s var(--ease-soft);
}
.nav-item::before {
  content: ''; position: absolute; inset: 0; border-radius: 12px; z-index: -1;
  background: linear-gradient(100deg, rgba(99, 102, 241, 0.32), rgba(34, 211, 238, 0.14));
  opacity: 0; transform: scale(0.96);
  transition: opacity 0.24s var(--ease-out), transform 0.24s var(--ease-out);
}
.nav-item::after {
  content: ''; position: absolute; left: 0; top: 50%; width: 3px; height: 0;
  border-radius: 3px; background: linear-gradient(180deg, var(--c2), var(--c1));
  transform: translateY(-50%); transition: height 0.28s var(--ease-out);
}
.nav-item:hover { color: #fff; transform: translateX(2px); }
.nav-item:hover::before { opacity: 0.55; transform: scale(1); }
.nav-item.active { color: #fff; font-weight: 600; }
.nav-item.active::before { opacity: 1; transform: scale(1); }
.nav-item.active::after { height: 22px; box-shadow: 0 0 12px 1px var(--c1); }
.nav-icon { font-size: 15px; width: 18px; text-align: center; transition: transform 0.28s var(--ease-out); }
.nav-item:hover .nav-icon { transform: scale(1.14) rotate(-6deg); }
.nav-badge {
  margin-left: auto; background: linear-gradient(135deg, var(--c7), var(--c3)); color: #fff;
  font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 20px;
  box-shadow: 0 4px 14px -4px var(--c7);
  animation: badge-pop 0.4s var(--ease-out) backwards;
}
@keyframes badge-pop { from { transform: scale(0.5); opacity: 0; } to { transform: scale(1); opacity: 1; } }

.sidebar-foot { margin-top: auto; display: flex; flex-direction: column; gap: 10px; position: relative; z-index: 1; }
.status { display: flex; align-items: center; gap: 8px; font-size: 12px; color: #93a0b8; padding: 0 6px; }
.status .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--muted); flex: none; }
.status-online .dot { background: #34d399; animation: live-pulse 2.2s ease-out infinite; }
.status-offline .dot { background: var(--danger); }
.status-connecting .dot { background: var(--warn); animation: live-pulse 1.2s ease-out infinite; }
@keyframes live-pulse {
  0% { box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.6); }
  70% { box-shadow: 0 0 0 8px rgba(52, 211, 153, 0); }
  100% { box-shadow: 0 0 0 0 rgba(52, 211, 153, 0); }
}

.content { padding: 30px 34px 64px; max-width: 1560px; width: 100%; }
.stack { display: flex; flex-direction: column; gap: 22px; }
.stack-sm { display: flex; flex-direction: column; gap: 14px; }
.page-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; flex-wrap: wrap; }
.button-row { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }

.screen { animation: rise 0.55s var(--ease-out) backwards; }
@keyframes rise { from { opacity: 0; transform: translateY(14px) scale(0.995); } to { opacity: 1; transform: none; } }

/* ----------------------------------------------------------------- cards -- */

.card {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  overflow: hidden;
  backdrop-filter: blur(var(--glass-blur));
  -webkit-backdrop-filter: blur(var(--glass-blur));
  position: relative;
  animation: rise 0.6s var(--ease-out) backwards;
  animation-delay: calc(var(--i, 0) * 55ms);
  transition: border-color 0.3s var(--ease-soft), box-shadow 0.3s var(--ease-soft);
}
.card::before {
  content: ''; position: absolute; inset: 0 0 auto; height: 1px;
  background: linear-gradient(90deg, transparent, rgba(99, 102, 241, 0.55), transparent);
  opacity: 0.7;
}
.card:hover { border-color: rgba(99, 102, 241, 0.35); }
.card-head {
  display: flex; justify-content: space-between; align-items: flex-start; gap: 14px;
  padding: 17px 20px; border-bottom: 1px solid var(--line-soft); flex-wrap: wrap;
}
.card-sub { font-size: 12.5px; color: var(--muted); margin-top: 3px; }
.card-body { padding: 20px; }
.card-actions { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
.pad { padding: 20px; }

.grid-2 { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); gap: 22px; }
.grid-3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(310px, 1fr)); gap: 22px; }

/* ------------------------------------------------------------------ stats - */

.stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 18px; }
.stat-grid-3 { grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); }
.stat {
  position: relative; overflow: hidden;
  background: var(--surface);
  border: 1px solid var(--line); border-radius: var(--radius);
  padding: 18px 20px 16px; box-shadow: var(--shadow);
  display: flex; flex-direction: column; gap: 7px;
  backdrop-filter: blur(var(--glass-blur)); -webkit-backdrop-filter: blur(var(--glass-blur));
  animation: rise 0.65s var(--ease-out) backwards;
  animation-delay: calc(var(--i, 0) * 70ms);
  transition: transform 0.3s var(--ease-out), border-color 0.3s var(--ease-soft), box-shadow 0.3s var(--ease-soft);
}
.stat:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
.stat::after {
  content: ''; position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
  background: radial-gradient(120% 90% at 100% 0%, var(--stat-glow, transparent), transparent 62%);
}
.stat-accent { --stat-glow: rgba(99, 102, 241, 0.22); border-color: var(--accent-line); }
.stat-warn { --stat-glow: rgba(251, 191, 36, 0.2); }
.stat-danger { --stat-glow: rgba(251, 113, 133, 0.2); }
.stat-top { display: flex; justify-content: space-between; align-items: center; }
.stat-label { font-size: 12.5px; color: var(--muted); font-weight: 600; letter-spacing: 0.01em; }
.stat-icon {
  font-size: 14px; width: 30px; height: 30px; display: grid; place-items: center;
  border-radius: 10px; background: var(--tint-strong); border: 1px solid var(--line);
}
.stat-value {
  font-size: 27px; letter-spacing: -0.035em; font-weight: 750; font-variant-numeric: tabular-nums;
}
.stat-foot { display: flex; justify-content: space-between; gap: 10px; font-size: 12px; color: var(--muted); flex-wrap: wrap; }
.stat-spark { position: absolute; inset: auto 0 0 0; height: 52px; opacity: 0.8; pointer-events: none; }
.stat-spark::after {
  content: ''; position: absolute; inset: 0;
  background: linear-gradient(180deg, transparent, var(--bg) 92%);
  opacity: 0.65;
}
.stat-bar { height: 5px; border-radius: 20px; background: var(--tint-strong); overflow: hidden; }
.stat-bar span { display: block; height: 100%; border-radius: 20px; animation: bar-sweep 1.1s var(--ease-out) 200ms backwards; }
.stat-bar-accent span { background: linear-gradient(90deg, var(--c1), var(--c2)); }
.stat-bar-warn span { background: linear-gradient(90deg, var(--c5), var(--c3)); }
.stat-bar-danger span { background: linear-gradient(90deg, var(--c7), var(--c3)); }
.stat-bar-default span { background: linear-gradient(90deg, var(--c1), var(--c6)); }
@keyframes bar-sweep { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }

.trend { font-weight: 650; white-space: nowrap; }
.trend i { font-style: normal; font-size: 10px; }
.trend-up { color: var(--good); }
.trend-down { color: var(--warn); }

.mini-stat {
  position: relative; overflow: hidden;
  background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius);
  padding: 15px 18px; box-shadow: var(--shadow); display: flex; flex-direction: column; gap: 3px;
  backdrop-filter: blur(var(--glass-blur)); -webkit-backdrop-filter: blur(var(--glass-blur));
  animation: rise 0.6s var(--ease-out) backwards; animation-delay: calc(var(--i, 0) * 60ms);
  transition: transform 0.3s var(--ease-out);
}
.mini-stat:hover { transform: translateY(-3px); }
.mini-stat span { font-size: 12.5px; color: var(--muted); font-weight: 550; }
.mini-stat strong { font-size: 22px; letter-spacing: -0.03em; font-variant-numeric: tabular-nums; }
.mini-stat small { font-size: 11.5px; color: var(--muted); }
.mini-stat.tone-accent { border-color: var(--accent-line); }
.mini-stat.tone-warn { border-color: rgba(251, 191, 36, 0.35); }
.mini-stat.tone-danger { border-color: rgba(251, 113, 133, 0.35); }

/* ---------------------------------------------------------------- buttons - */

.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 7px;
  border: 1px solid var(--line); background: var(--tint); color: var(--text);
  border-radius: 11px; padding: 8px 14px; font: inherit; font-weight: 600;
  cursor: pointer; text-decoration: none; white-space: nowrap; position: relative; overflow: hidden;
  transition: background 0.2s var(--ease-soft), border-color 0.2s var(--ease-soft),
    box-shadow 0.25s var(--ease-soft), transform 0.12s var(--ease-soft), color 0.2s var(--ease-soft);
}
.btn:hover:not(:disabled) { background: var(--tint-strong); border-color: rgba(99, 102, 241, 0.42); transform: translateY(-1px); }
.btn:active:not(:disabled) { transform: translateY(1px) scale(0.985); }
.btn:disabled { opacity: 0.5; cursor: not-allowed; }
.btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.btn-primary {
  background: linear-gradient(120deg, var(--c1), var(--c2)); border-color: transparent; color: #fff;
  box-shadow: 0 10px 26px -12px var(--c1);
}
.btn-primary:hover:not(:disabled) { box-shadow: 0 16px 34px -12px var(--c1); transform: translateY(-1px); }
.btn-primary::after {
  content: ''; position: absolute; inset: 0;
  background: linear-gradient(110deg, transparent 32%, rgba(255, 255, 255, 0.45) 50%, transparent 68%);
  transform: translateX(-120%); transition: transform 0.7s var(--ease-out);
}
.btn-primary:hover::after { transform: translateX(120%); }
.btn-danger { background: linear-gradient(120deg, var(--c7), var(--c3)); border-color: transparent; color: #fff; }
.btn-danger-ghost { color: var(--danger); border-color: rgba(251, 113, 133, 0.45); background: var(--danger-soft); }
.btn-danger-ghost:hover:not(:disabled) { background: rgba(251, 113, 133, 0.22); }
.btn-sm { padding: 6px 11px; font-size: 12.5px; border-radius: 9px; }
.btn-block { width: 100%; }

.icon-btn {
  border: 1px solid transparent; background: transparent; cursor: pointer; color: var(--muted);
  font-size: 13px; padding: 7px 9px; border-radius: 9px; line-height: 1; font-family: inherit;
  transition: background 0.2s var(--ease-soft), color 0.2s var(--ease-soft), transform 0.25s var(--ease-out);
}
.icon-btn:hover { background: var(--tint-strong); color: var(--text); transform: rotate(90deg); }
.link-btn {
  border: 0; background: none; color: var(--accent-2); cursor: pointer;
  font: inherit; font-size: 12.5px; font-weight: 600; padding: 3px 6px; border-radius: 7px;
  transition: color 0.2s var(--ease-soft), background 0.2s var(--ease-soft);
}
.link-btn:hover { background: var(--accent-soft); }
.link-btn:disabled { opacity: 0.5; }

.segmented {
  display: inline-flex; background: var(--tint); border: 1px solid var(--line);
  border-radius: 12px; padding: 3px; gap: 2px;
}
.segmented button {
  border: 0; background: transparent; padding: 6px 13px; border-radius: 9px;
  font: inherit; font-size: 12.5px; font-weight: 600; color: var(--muted); cursor: pointer;
  transition: color 0.2s var(--ease-soft), background 0.25s var(--ease-soft), box-shadow 0.25s var(--ease-soft);
}
.segmented button:hover { color: var(--text); }
.segmented button.active {
  background: var(--accent-soft); color: var(--text);
  box-shadow: 0 0 0 1px var(--accent-line), 0 6px 18px -10px var(--accent);
}

/* ------------------------------------------------------------------ forms - */

input, select, textarea {
  font: inherit; color: var(--text); background: var(--input-bg);
  border: 1px solid var(--line); border-radius: var(--radius-sm);
  padding: 9px 12px; width: 100%;
  transition: border-color 0.2s var(--ease-soft), box-shadow 0.25s var(--ease-soft), background 0.2s var(--ease-soft);
}
input::placeholder, textarea::placeholder { color: var(--muted); opacity: 0.78; }
input:focus, select:focus, textarea:focus {
  outline: none; border-color: var(--accent);
  box-shadow: 0 0 0 3px var(--accent-soft), 0 0 24px -8px var(--accent);
}
textarea { resize: vertical; }
select { cursor: pointer; }
.form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }
.field { display: flex; flex-direction: column; gap: 6px; }
.field-wide { grid-column: 1 / -1; }
.field-label { font-size: 12.5px; font-weight: 600; color: var(--text-2); }
.field-hint { font-size: 11.5px; color: var(--muted); }
.field-msg { font-size: 11.5px; color: var(--danger); }
.field-error input, .field-error select { border-color: var(--danger); }
.checkbox { display: flex; align-items: center; gap: 9px; font-size: 12.5px; color: var(--text-2); margin: 0; }
.checkbox input { width: auto; accent-color: var(--accent); }
.inline-field { display: inline-flex; align-items: center; gap: 7px; font-size: 12.5px; color: var(--muted); white-space: nowrap; }
.inline-field input { width: auto; padding: 7px 10px; }
.qty-input { width: 92px; padding: 6px 9px; }

/* ---------------------------------------------------------------- toolbar - */

.toolbar {
  display: flex; gap: 10px; align-items: center; flex-wrap: wrap;
  padding: 15px 18px; border-bottom: 1px solid var(--line-soft); background: var(--tint);
}
.toolbar-plain { border-bottom: 0; background: transparent; padding: 0; }
.toolbar > select, .toolbar > .inline-field { width: auto; min-width: 132px; }
.toolbar-right { margin-left: auto; display: flex; gap: 8px; }
.search { position: relative; flex: 1 1 260px; min-width: 200px; display: flex; align-items: center; }
.search span { position: absolute; left: 12px; font-size: 12px; opacity: 0.6; pointer-events: none; transition: transform 0.25s var(--ease-out); }
.search:focus-within span { transform: scale(1.18); }
.search input { padding-left: 34px; }

/* ----------------------------------------------------------------- tables - */

.table-scroll { overflow-x: auto; }
.table { width: 100%; border-collapse: collapse; }
.table th, .table td { padding: 12px 15px; text-align: left; border-bottom: 1px solid var(--line-soft); vertical-align: middle; }
.table thead th {
  font-size: 11px; text-transform: uppercase; letter-spacing: 0.07em; color: var(--muted);
  background: var(--surface-solid); font-weight: 700; white-space: nowrap;
  position: sticky; top: 0; z-index: 1;
}
.table tbody tr { transition: background 0.2s var(--ease-soft); }
.table-hover tbody tr:hover { background: var(--accent-soft); }
.table tbody tr:last-child td { border-bottom: 0; }
.table-compact th, .table-compact td { padding: 9px 13px; }
.table .num { text-align: right; font-variant-numeric: tabular-nums; }
.cell-main { font-weight: 600; }
.row-muted { opacity: 0.55; }
.row-actions { white-space: nowrap; text-align: right; }
.th-sort {
  border: 0; background: none; font: inherit; font-size: 11px; text-transform: uppercase;
  letter-spacing: 0.07em; color: var(--muted); font-weight: 700; cursor: pointer; padding: 0;
  transition: color 0.2s var(--ease-soft);
}
.th-sort:hover, .th-sort.active { color: var(--accent-2); }
.table-foot {
  display: flex; justify-content: space-between; align-items: center; gap: 12px;
  padding: 13px 18px; border-top: 1px solid var(--line-soft); flex-wrap: wrap;
}

/* ------------------------------------------------------------------ pager - */

.pager { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
.pager-buttons { display: flex; align-items: center; gap: 8px; }
.pager-page { font-size: 12.5px; color: var(--muted); font-variant-numeric: tabular-nums; }

/* ----------------------------------------------------------------- badges - */

.badge {
  display: inline-flex; align-items: center; gap: 5px; padding: 3px 10px;
  border-radius: 20px; font-size: 11.5px; font-weight: 650; white-space: nowrap;
  background: var(--tint-strong); color: var(--muted); border: 1px solid transparent;
}
.badge-ok { background: var(--good-soft); color: var(--good); border-color: rgba(52, 211, 153, 0.32); }
.badge-low { background: var(--warn-soft); color: var(--warn); border-color: rgba(251, 191, 36, 0.32); }
.badge-out { background: var(--danger-soft); color: var(--danger); border-color: rgba(251, 113, 133, 0.36); }
.badge-neutral { background: var(--tint-strong); color: var(--muted); }
.badge-accent { background: var(--accent-soft); color: var(--accent-2); }
.badge-low, .badge-out { animation: badge-in 0.4s var(--ease-out) backwards; }
@keyframes badge-in { from { transform: scale(0.7); opacity: 0; } to { transform: scale(1); opacity: 1; } }
.chip {
  display: inline-flex; align-items: center; padding: 2px 10px; border-radius: 20px;
  font-size: 11.5px; font-weight: 650; background: var(--tint-strong); color: var(--muted);
  border: 1px solid var(--line);
}
.chip-in { background: var(--good-soft); color: var(--good); border-color: rgba(52, 211, 153, 0.3); }
.chip-out { background: var(--danger-soft); color: var(--danger); border-color: rgba(251, 113, 133, 0.3); }
.coverage { font-weight: 700; padding: 2px 9px; border-radius: 20px; font-variant-numeric: tabular-nums; }
.coverage-ok { color: var(--good); background: var(--good-soft); }
.coverage-warn { color: var(--warn); background: var(--warn-soft); }
.coverage-crit { color: var(--danger); background: var(--danger-soft); animation: badge-in 0.4s var(--ease-out) backwards; }

/* ------------------------------------------------------------------ modal - */

.modal-backdrop {
  position: fixed; inset: 0; background: var(--scrim);
  display: flex; align-items: flex-start; justify-content: center; padding: 44px 16px;
  z-index: 50; overflow-y: auto;
  backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
  animation: fade 0.22s var(--ease-soft);
}
@keyframes fade { from { opacity: 0; } to { opacity: 1; } }
.modal {
  background: var(--surface-solid); border: 1px solid var(--line);
  border-radius: var(--radius); width: 100%; box-shadow: var(--shadow-lg); margin: auto 0;
  animation: modal-in 0.4s var(--ease-out); overflow: hidden; position: relative;
}
@keyframes modal-in {
  from { opacity: 0; transform: translateY(-14px) scale(0.97); }
  to { opacity: 1; transform: none; }
}
.modal::before {
  content: ''; position: absolute; inset: 0 0 auto; height: 2px; z-index: 2;
  background: linear-gradient(90deg, var(--c1), var(--c2), var(--c3));
}
.modal-head {
  display: flex; justify-content: space-between; align-items: flex-start; gap: 14px;
  padding: 19px 22px; border-bottom: 1px solid var(--line-soft);
}
.modal-body { padding: 22px; max-height: 68vh; overflow-y: auto; }
.modal-foot {
  display: flex; gap: 9px; align-items: center; padding: 15px 22px;
  border-top: 1px solid var(--line-soft); background: var(--tint); flex-wrap: wrap;
}
.spacer { flex: 1; }

.sub-head { margin: 22px 0 11px; }
.detail-grid, .kv-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 15px; }
.detail-grid > div, .kv-grid > div { display: flex; flex-direction: column; gap: 4px; }
.detail-grid strong { font-size: 15px; }
.kv-grid strong { font-size: 18px; letter-spacing: -0.03em; font-variant-numeric: tabular-nums; }
.detail-note {
  margin-top: 18px; padding: 13px 15px; background: var(--tint);
  border: 1px solid var(--line-soft); border-radius: var(--radius-sm); color: var(--text-2); font-size: 13px;
}

/* ------------------------------------------------------------ pickers/lists */

.picker {
  border: 1px solid var(--line); border-radius: var(--radius-sm); overflow: hidden;
  max-height: 230px; overflow-y: auto; background: var(--input-bg);
}
.picker li + li { border-top: 1px solid var(--line-soft); }
.picker button {
  display: flex; justify-content: space-between; align-items: center; gap: 12px; width: 100%;
  background: transparent; border: 0; padding: 11px 14px; font: inherit; cursor: pointer; text-align: left;
  color: var(--text); transition: background 0.2s var(--ease-soft), padding-left 0.2s var(--ease-out);
}
.picker button:hover:not(:disabled) { background: var(--accent-soft); padding-left: 18px; }
.picker button:disabled { opacity: 0.45; cursor: not-allowed; }
.picker .pad { padding: 13px 14px; }
.selected-product {
  display: flex; justify-content: space-between; align-items: center; gap: 16px;
  padding: 13px 15px; background: var(--accent-soft); border-radius: var(--radius-sm);
  border: 1px solid var(--accent-line); animation: rise 0.35s var(--ease-out) backwards;
}
.selected-right { display: flex; align-items: center; gap: 10px; }

.alert-list { display: flex; flex-direction: column; }
.alert-list li {
  display: flex; justify-content: space-between; align-items: center; gap: 12px;
  padding: 11px 8px; border-bottom: 1px solid var(--line-soft); border-radius: 10px;
  animation: rise 0.5s var(--ease-out) backwards; animation-delay: calc(var(--i, 0) * 45ms);
  transition: background 0.2s var(--ease-soft), transform 0.2s var(--ease-out), padding-left 0.2s var(--ease-out);
}
.alert-list li:hover { background: var(--tint); padding-left: 14px; }
.alert-list li:last-child { border-bottom: 0; }
.alert-list strong { display: block; font-size: 13.5px; font-weight: 600; }
.alert-right { display: flex; align-items: center; gap: 10px; white-space: nowrap; }
.qty { font-variant-numeric: tabular-nums; font-size: 12.5px; color: var(--muted); }

/* ----------------------------------------------------------------- charts - */

.chart-wrap { position: relative; }
.chart { width: 100%; height: auto; overflow: visible; }
.chart .grid { stroke: var(--line-soft); stroke-width: 1; }
.chart .axis { fill: var(--muted); font-size: 10px; font-weight: 500; }
.chart-highlight { fill: var(--tint-strong); }
.bar { transition: transform 700ms var(--ease-out), opacity 0.2s var(--ease-soft), filter 0.2s var(--ease-soft); }
.chart-wrap:hover .bar { opacity: 0.42; }
.chart-wrap .bar:hover { opacity: 1; filter: drop-shadow(0 0 10px currentColor); }
.chart-node { transition: opacity 400ms var(--ease-soft); }
.legend { display: flex; gap: 18px; justify-content: center; margin-top: 10px; font-size: 12px; color: var(--muted); }
.legend-item { display: inline-flex; align-items: center; gap: 7px; }
.swatch { width: 10px; height: 10px; border-radius: 3px; display: inline-block; flex: none; }
.chart-tip {
  position: absolute; top: 4px; transform: translateX(-50%);
  background: var(--surface-solid); color: var(--text);
  border: 1px solid var(--accent-line);
  padding: 9px 12px; border-radius: 12px;
  font-size: 11.5px; display: flex; flex-direction: column; gap: 4px;
  box-shadow: var(--shadow-lg); white-space: nowrap; z-index: 3; pointer-events: none;
  animation: tip-in 0.18s var(--ease-out);
}
@keyframes tip-in { from { opacity: 0; transform: translate(-50%, -6px); } to { opacity: 1; transform: translateX(-50%); } }
.chart-tip strong { font-size: 12px; }
.chart-tip span { display: inline-flex; align-items: center; gap: 6px; }

.spark { width: 100%; height: 100%; display: block; color: var(--accent); }
.spark-accent { color: var(--accent); }
.spark-warn { color: var(--warn); }
.spark-danger { color: var(--danger); }
.spark-default { color: var(--c2); }
.spark-line { stroke: currentColor; stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; transition: stroke-dashoffset 1400ms var(--ease-out); }
.spark-area { transition: opacity 900ms var(--ease-soft); }

/* Donut */
.donut-wrap { display: flex; gap: 22px; align-items: center; flex-wrap: wrap; }
.donut { position: relative; width: 178px; height: 178px; flex: none; }
.donut-svg { width: 100%; height: 100%; overflow: visible; filter: drop-shadow(0 10px 26px -14px var(--c1)); }
.donut-track { fill: none; stroke: var(--tint-strong); stroke-width: 15; }
.donut-seg { cursor: pointer; transition: opacity 0.22s var(--ease-soft), stroke-width 0.22s var(--ease-soft); }
.donut-center {
  position: absolute; inset: 0; display: flex; flex-direction: column;
  align-items: center; justify-content: center; text-align: center; gap: 1px; pointer-events: none; padding: 0 24px;
}
.donut-center strong { font-size: 19px; letter-spacing: -0.03em; font-variant-numeric: tabular-nums; }
.donut-legend { flex: 1 1 210px; display: flex; flex-direction: column; gap: 2px; min-width: 0; }
.donut-legend li {
  display: grid; grid-template-columns: 12px 1fr auto auto; gap: 9px; align-items: center;
  padding: 7px 9px; border-radius: 10px; font-size: 12.5px;
  animation: rise 0.45s var(--ease-out) backwards; animation-delay: calc(var(--i, 0) * 50ms);
  transition: background 0.2s var(--ease-soft), transform 0.2s var(--ease-out);
}
.donut-legend li.active { background: var(--accent-soft); transform: translateX(3px); }
.donut-legend-label { font-weight: 550; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.donut-legend-value { font-variant-numeric: tabular-nums; color: var(--muted); }
.donut-legend-share { font-variant-numeric: tabular-nums; font-weight: 650; min-width: 46px; text-align: right; }

/* Rank bars */
.rank { display: flex; flex-direction: column; gap: 13px; }
.rank li { animation: rise 0.5s var(--ease-out) backwards; animation-delay: calc(var(--i, 0) * 55ms); }
.rank-row { display: flex; justify-content: space-between; gap: 12px; font-size: 13px; margin-bottom: 6px; }
.rank-label { font-weight: 600; }
.rank-value { font-variant-numeric: tabular-nums; color: var(--muted); white-space: nowrap; }
.rank-track { height: 8px; background: var(--tint-strong); border-radius: 20px; overflow: hidden; position: relative; }
.rank-fill { height: 100%; border-radius: 20px; position: relative; transition: width 900ms var(--ease-out); }
.rank-fill::after {
  content: ''; position: absolute; inset: 0;
  background: linear-gradient(110deg, transparent 30%, rgba(255, 255, 255, 0.5) 50%, transparent 70%);
  transform: translateX(-120%);
  animation: sheen 3.4s var(--ease-soft) infinite;
}
.rank-accent { background: linear-gradient(90deg, var(--c1), var(--c2)); }
.rank-warn { background: linear-gradient(90deg, var(--c5), var(--c3)); }
.rank-meta { display: block; font-size: 11.5px; color: var(--muted); margin-top: 5px; }

/* Bucketed (weekly / monthly) bars */

/* --------------------------------------------------------- empty / loading */

.empty { text-align: center; padding: 34px 16px; display: flex; flex-direction: column; align-items: center; gap: 8px; color: var(--muted); }
.empty-icon {
  font-size: 20px; width: 46px; height: 46px; display: grid; place-items: center;
  border-radius: 14px; background: var(--tint-strong); border: 1px solid var(--line);
  color: var(--accent-2); animation: float 3.6s ease-in-out infinite;
}
@keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-5px); } }
.empty strong { color: var(--text); font-size: 14px; }
.empty p { font-size: 12.5px; max-width: 430px; }

.skeleton-list { display: flex; flex-direction: column; gap: 11px; padding: 20px; }
.skeleton-row {
  height: 15px; border-radius: 7px;
  background: linear-gradient(90deg, var(--tint) 25%, var(--tint-strong) 37%, var(--tint) 63%);
  background-size: 400% 100%; animation: shimmer 1.4s ease-in-out infinite;
  animation-delay: calc(var(--i, 0) * 90ms);
}
@keyframes shimmer { 0% { background-position: 100% 50%; } 100% { background-position: 0 50%; } }

/* ---------------------------------------------------------------- toasts -- */

.toasts { position: fixed; right: 22px; bottom: 22px; display: flex; flex-direction: column; gap: 10px; z-index: 100; max-width: 390px; }
.toast {
  position: relative; overflow: hidden;
  display: flex; align-items: flex-start; gap: 10px;
  background: var(--surface-solid); color: var(--text);
  border: 1px solid var(--line);
  padding: 12px 15px 13px; border-radius: 13px; box-shadow: var(--shadow-lg); font-size: 13px;
  animation: toast-in 0.35s var(--ease-out);
}
@keyframes toast-in { from { opacity: 0; transform: translateX(24px) scale(0.96); } to { opacity: 1; transform: none; } }
.toast-success { border-left: 3px solid var(--good); }
.toast-error { border-left: 3px solid var(--danger); }
.toast-info { border-left: 3px solid var(--accent-2); }
.toast-icon { color: var(--accent-2); font-size: 13px; line-height: 1.4; }
.toast-success .toast-icon { color: var(--good); }
.toast-error .toast-icon { color: var(--danger); }
.toast-timer { position: absolute; left: 0; bottom: 0; height: 2px; width: 100%; transform-origin: left; background: linear-gradient(90deg, var(--c1), var(--c2)); animation: toast-timer 4.4s linear forwards; }
@keyframes toast-timer { from { transform: scaleX(1); } to { transform: scaleX(0); } }

/* ---------------------------------------------------------- theme toggle -- */

.theme-toggle {
  display: flex; align-items: center; gap: 10px; width: 100%;
  padding: 9px 13px; border-radius: 12px; cursor: pointer;
  background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(148, 163, 184, 0.16);
  color: #cbd5e1; font: inherit; font-size: 12.5px; font-weight: 550;
  transition: background 0.25s var(--ease-soft), border-color 0.25s var(--ease-soft), transform 0.2s var(--ease-out);
}
.theme-toggle:hover { background: rgba(255, 255, 255, 0.11); border-color: rgba(148, 163, 184, 0.32); transform: translateY(-1px); }
.theme-toggle .toggle-track {
  position: relative; width: 38px; height: 21px; border-radius: 20px; flex: none;
  background: linear-gradient(120deg, var(--c1), var(--c2));
  box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.4);
}
.theme-toggle .toggle-knob {
  position: absolute; top: 2px; left: 2px; width: 17px; height: 17px; border-radius: 50%;
  background: #fff; display: grid; place-items: center; font-size: 10px;
  transition: transform 0.42s var(--ease-out);
}
.theme-toggle[data-theme='light'] .toggle-knob { transform: translateX(17px); }

/* ---------------------------------------------------------------- scroll -- */

.table-scroll::-webkit-scrollbar, .modal-body::-webkit-scrollbar, .picker::-webkit-scrollbar { width: 10px; height: 10px; }
.table-scroll::-webkit-scrollbar-thumb, .modal-body::-webkit-scrollbar-thumb, .picker::-webkit-scrollbar-thumb {
  background: var(--tint-strong); border-radius: 20px; border: 3px solid transparent; background-clip: content-box;
}
.table-scroll::-webkit-scrollbar-thumb:hover { background: var(--accent-line); background-clip: content-box; }
.table-scroll::-webkit-scrollbar-track { background: transparent; }

/* ------------------------------------------------------------ brand marks -- */

/* Logo beside every page title. */
.head-text { display: flex; align-items: flex-start; gap: 14px; }
.head-mark { flex: none; margin-top: 1px; filter: drop-shadow(0 10px 22px rgba(99, 102, 241, 0.35)); }

/* Oversized ghost mark painted into the sidebar. */
.sidebar-ghost {
  position: absolute; right: -74px; bottom: -66px; opacity: 0.062;
  pointer-events: none; transform: rotate(-8deg);
}

.brand-credit {
  display: flex; align-items: center; gap: 8px; padding: 10px 6px 0;
  font-size: 11px; color: #7d879e; letter-spacing: 0.01em;
}
.brand-credit .credit-mark { opacity: 0.85; flex: none; }

/* Page footer lockup. */
.app-foot {
  display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap;
  margin-top: 44px; padding-top: 18px; border-top: 1px solid var(--line-soft);
  font-size: 12px; color: var(--muted);
}
.app-foot-brand { display: inline-flex; align-items: center; gap: 10px; }
.app-foot-brand strong { color: var(--text); }
.app-foot-link { color: var(--accent-2); text-decoration: none; }
.app-foot-link:hover { text-decoration: underline; }

/* Empty / loading / modal states carry the mark too. */
.empty-mark { animation: float 3.6s ease-in-out infinite; filter: drop-shadow(0 12px 26px rgba(99, 102, 241, 0.35)); }
.skeleton-head { display: flex; align-items: center; gap: 10px; color: var(--muted); font-size: 12.5px; font-weight: 600; }
.skeleton-mark { animation: mark-pulse 2.6s var(--ease-soft) infinite; }
@keyframes mark-pulse { 0%, 100% { opacity: 0.7; transform: scale(1); } 50% { opacity: 1; transform: scale(1.07); } }
.modal-title { display: flex; align-items: flex-start; gap: 12px; }
.modal-mark { flex: none; margin-top: 1px; }

/* ------------------------------------------------------------ watermark -- */

/* One cyber watermark, centred: a technical grid behind the whole app, a
   scanline sweep, and a single emblem (outline mark + HUD ring + reticle +
   readout) in the middle of the viewport. Above the content, below modals
   (z-index 50) and toasts (100). */
.site-watermark {
  position: fixed; inset: 0; z-index: 2; pointer-events: none;
  display: grid; place-items: center; overflow: hidden;
  color: var(--cyber-ink); opacity: var(--cyber-opacity);
  mix-blend-mode: screen;
}
:root[data-theme='light'] .site-watermark { mix-blend-mode: multiply; }

.cyber-grid {
  position: absolute; inset: -6%;
  background-image:
    repeating-linear-gradient(0deg, var(--cyber-grid) 0 1px, transparent 1px 34px),
    repeating-linear-gradient(90deg, var(--cyber-grid) 0 1px, transparent 1px 34px);
  mask-image: radial-gradient(circle at 50% 45%, #000 0%, #000 52%, transparent 84%);
  -webkit-mask-image: radial-gradient(circle at 50% 45%, #000 0%, #000 52%, transparent 84%);
}
.cyber-glow {
  position: absolute; width: 78vmin; height: 78vmin; border-radius: 50%;
  background: radial-gradient(circle, currentColor 0%, transparent 66%);
  opacity: 0.25;
}
.cyber-emblem {
  position: relative; width: var(--cyber-size, clamp(220px, 34vmin, 460px)); aspect-ratio: 1;
  display: grid; place-items: center;
}
.cyber-mark { width: 60%; height: 60%; opacity: 0.9; }
.cyber-ring {
  position: absolute; inset: 0; border-radius: 50%;
  border: 1.5px dashed currentColor; opacity: 0.55;
  animation: cyber-spin 52s linear infinite;
}
.cyber-bracket { position: absolute; width: 24px; height: 24px; border: 2px solid currentColor; opacity: 0.5; }
.cyber-bracket-tl { top: 0; left: 0; border-right: 0; border-bottom: 0; }
.cyber-bracket-tr { top: 0; right: 0; border-left: 0; border-bottom: 0; }
.cyber-bracket-br { bottom: 0; right: 0; border-left: 0; border-top: 0; }
.cyber-bracket-bl { bottom: 0; left: 0; border-right: 0; border-top: 0; }
.cyber-label {
  position: absolute; bottom: -1.9rem; left: 50%; transform: translateX(-50%);
  font-family: var(--mono); font-size: 10.5px; letter-spacing: 0.32em;
  white-space: nowrap; opacity: 0.85;
}
.cyber-scan {
  position: absolute; left: 0; right: 0; height: 20vh;
  background: linear-gradient(180deg, transparent, currentColor 50%, transparent);
  opacity: 0.07; animation: cyber-scan 13s linear infinite;
}
@keyframes cyber-spin { to { transform: rotate(360deg); } }
@keyframes cyber-scan { from { transform: translateY(-30vh); } to { transform: translateY(130vh); } }

/* ------------------------------------------------------------------ a11y -- */

:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 6px; }

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.001ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.001ms !important;
    scroll-behavior: auto !important;
  }
  body::before, body::after { animation: none !important; }
  .stat:hover, .mini-stat:hover, .btn:hover:not(:disabled) { transform: none; }
  .login-aurora, .boot-bar i, .login-card[data-shake] { animation: none !important; }
  .session-card:hover, .demo-row:hover { transform: none; }
}

/* ------------------------------------------------------------ responsive -- */

@media (max-width: 1180px) { .grid-2 { grid-template-columns: 1fr; } }
@media (max-width: 880px) {
  body::before, body::after { width: 90vw; height: 90vw; }
  .app { grid-template-columns: 1fr; }
  .sidebar { position: static; height: auto; }
  .sidebar nav { flex-direction: row; overflow-x: auto; padding-bottom: 4px; }
  .nav-item span:not(.nav-icon) { white-space: nowrap; }
  .nav-item::after { display: none; }
  .content { padding: 22px 16px 48px; }
  .form-grid { grid-template-columns: 1fr; }
  .donut-wrap { justify-content: center; }
}

@media (prefers-reduced-motion: reduce) {
  .cyber-ring, .cyber-scan, .empty-mark, .skeleton-mark { animation: none !important; }
  .cyber-scan { opacity: 0; }
}

@media (max-width: 880px) {
  .sidebar-ghost { display: none; }
  .head-mark { width: 30px; height: 30px; }
  .app-foot { margin-top: 28px; }
  .cyber-label { font-size: 8.5px; letter-spacing: 0.2em; }
  .cyber-bracket { width: 16px; height: 16px; }
}

/* Decoration should not eat toner. */
@media print {
  .site-watermark, .sidebar-ghost, .toasts { display: none !important; }
}

/* ==========================================================================
   Report visualisation set: gauges, meters, treemap, heatmap, waterfall,
   stacked columns, mini bars — all animated in and reduced-motion aware.
   ========================================================================== */

@property --spin { syntax: '<angle>'; inherits: false; initial-value: 0deg; }

/* ---------------------------------------------------------- gauges/rings -- */

.gauge { position: relative; display: grid; place-items: center; }
.gauge svg { width: 100%; height: auto; display: block; }
.gauge-track { fill: none; stroke: var(--tint-strong); stroke-width: 13; stroke-linecap: round; }
.gauge-value { stroke-width: 13; stroke-linecap: round; filter: drop-shadow(0 0 12px rgba(99, 102, 241, 0.45)); }
.gauge-tick { stroke: var(--line); stroke-width: 2; opacity: 0.45; transition: stroke 0.35s var(--ease-soft), opacity 0.35s var(--ease-soft); }
.gauge-tick.on { stroke: var(--accent-2); opacity: 0.9; }
.gauge-tick.major { stroke-width: 3.2; }
.gauge-dot { fill: var(--surface-solid); stroke: var(--accent-2); stroke-width: 2.6; filter: drop-shadow(0 0 9px var(--accent-2)); }
.gauge-center { position: absolute; inset: auto 0 20%; display: grid; justify-items: center; gap: 5px; text-align: center; }
.gauge-label { font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.16em; color: var(--muted); font-weight: 650; }
.gauge-number {
  font-size: 46px; line-height: 1; font-weight: 780; letter-spacing: -0.035em;
  background: var(--title-gradient); -webkit-background-clip: text; background-clip: text; color: transparent;
}
.gauge-grade {
  font-size: 10.5px; font-weight: 700; letter-spacing: 0.13em; text-transform: uppercase;
  padding: 3px 10px; border-radius: 20px; color: var(--accent-2);
  background: var(--accent-soft); border: 1px solid var(--accent-line);
}
.gauge-caption { font-size: 11.5px; color: var(--muted); max-width: 200px; }

.ring-strip { display: flex; flex-wrap: wrap; gap: 10px; }
.ring-stat {
  display: flex; align-items: center; gap: 12px; flex: 1 1 190px; position: relative; overflow: hidden;
  padding: 12px 14px; border-radius: 14px; background: var(--tint); border: 1px solid var(--line-soft);
  transition: transform 0.32s var(--ease-out), border-color 0.32s var(--ease-soft), background 0.32s var(--ease-soft);
  animation: rise 0.5s var(--ease-out) backwards;
}
.ring-stat:hover { transform: translateY(-3px); border-color: var(--accent-line); background: var(--tint-strong); }
.ring-stat::after {
  content: ''; position: absolute; inset: 0; pointer-events: none;
  background: linear-gradient(115deg, transparent 35%, rgba(255, 255, 255, 0.07) 50%, transparent 65%);
  transform: translateX(-100%);
}
.ring-stat:hover::after { animation: sheen-pass 0.9s var(--ease-soft); }
@keyframes sheen-pass { to { transform: translateX(100%); } }
.ring { position: relative; display: grid; place-items: center; flex: none; }
.ring svg { width: 100%; height: 100%; }
.ring-track { fill: none; stroke: var(--tint-strong); stroke-width: 5; }
.ring-value { fill: none; stroke: var(--accent-2); stroke-width: 5; stroke-linecap: round; transition: stroke-dashoffset 0.25s linear; }
.ring-number { position: absolute; display: flex; align-items: baseline; gap: 1px; font-size: 12.5px; font-weight: 720; }
.ring-number i { font-style: normal; font-size: 8.5px; color: var(--muted); }
.ring-copy { display: grid; gap: 2px; min-width: 0; }
.ring-label { font-size: 12.5px; font-weight: 620; }
.ring-copy small { font-size: 11px; color: var(--muted); }
.ring-good .ring-value { stroke: var(--good); }
.ring-warn .ring-value { stroke: var(--warn); }
.ring-danger .ring-value { stroke: var(--danger); }

.meters { display: grid; gap: 15px; }
.meter { display: grid; gap: 6px; animation: rise 0.55s var(--ease-out) backwards; animation-delay: calc(var(--i, 0) * 80ms); }
.meter-head { display: flex; justify-content: space-between; gap: 10px; font-size: 12.5px; }
.meter-label { color: var(--text-2); font-weight: 620; }
.meter-value { font-family: var(--mono); font-size: 12px; color: var(--text); }
.meter-track { height: 7px; border-radius: 20px; background: var(--tint-strong); overflow: hidden; }
.meter-track > span {
  display: block; height: 100%; border-radius: 20px; box-shadow: 0 0 14px -3px var(--accent);
  background: linear-gradient(90deg, var(--accent), var(--accent-2));
  transition: width 950ms var(--ease-out);
}
.meter-hint { font-size: 11px; color: var(--muted); }
.meter-good .meter-track > span { background: linear-gradient(90deg, var(--good), var(--accent-2)); }
.meter-warn .meter-track > span { background: linear-gradient(90deg, var(--warn), var(--c3)); }
.meter-danger .meter-track > span { background: linear-gradient(90deg, var(--danger), var(--c3)); }

/* --------------------------------------------------------------- treemap -- */

.treemap { display: grid; grid-template-rows: 1fr auto; gap: 9px; animation: rise 0.6s var(--ease-out) backwards; }
.treemap-map { position: relative; border-radius: 13px; overflow: hidden; background: var(--tint); border: 1px solid var(--line-soft); }
.treemap-cell {
  position: absolute; display: flex; flex-direction: column; justify-content: space-between; gap: 3px;
  padding: 9px 10px; border: 0; overflow: hidden; cursor: pointer; text-align: left; font: inherit; color: #fff;
  transition: transform 0.45s var(--ease-out), opacity 0.45s var(--ease-out), filter 0.25s var(--ease-soft);
}
.treemap-cell::after {
  content: ''; position: absolute; inset: 0; background: rgba(0, 0, 0, 0.2); opacity: 0;
  transition: opacity 0.25s var(--ease-soft);
}
.treemap-cell:hover::after, .treemap-cell.active::after, .treemap-cell:focus-visible::after { opacity: 1; }
.treemap-cell > * { position: relative; z-index: 1; }
.treemap-name { font-size: 12px; font-weight: 650; line-height: 1.25; }
.treemap-value { font-size: 14.5px; font-weight: 750; letter-spacing: -0.02em; }
.treemap-share { font-size: 10.5px; opacity: 0.85; }
.treemap-readout { font-size: 12.5px; min-height: 17px; display: flex; gap: 8px; align-items: baseline; flex-wrap: wrap; }
.treemap-readout strong { font-weight: 650; }
.treemap-readout span { color: var(--muted); font-size: 11.5px; }

/* --------------------------------------------------------------- heatmap -- */

.heat { display: grid; gap: 10px; animation: rise 0.6s var(--ease-out) backwards; }
.heat-readout { font-size: 12.5px; min-height: 18px; font-variant-numeric: tabular-nums; }
.heat-body { display: grid; grid-template-columns: auto 1fr; gap: 8px; }
.heat-rows { display: grid; grid-template-rows: repeat(7, 1fr); gap: 4px; height: 170px; }
.heat-row-label { font-size: 10.5px; color: var(--muted); display: flex; align-items: center; justify-content: flex-end; padding-right: 2px; }
.heat-grid { display: grid; grid-template-rows: repeat(7, 1fr); gap: 4px; height: 170px; }
.heat-cell {
  position: relative; border-radius: 5px; background: var(--tint); overflow: hidden; cursor: crosshair;
  animation: heat-in 0.5s var(--ease-out) backwards; animation-delay: calc(var(--i, 0) * 11ms);
}
.heat-cell::after {
  content: ''; position: absolute; inset: 0; background: linear-gradient(135deg, var(--accent), var(--accent-2));
  opacity: calc(0.07 + var(--t, 0) * 0.93);
  transition: opacity 0.5s var(--ease-soft), box-shadow 0.25s var(--ease-soft);
}
.heat-cell[data-empty='true']::after { background: var(--tint-strong); opacity: 1; }
.heat-cell:hover::after, .heat-cell.active::after {
  opacity: 1; box-shadow: inset 0 0 0 2px var(--text), 0 0 16px -2px var(--accent-2);
}
@keyframes heat-in { from { transform: scale(0.72); opacity: 0; } to { transform: none; opacity: 1; } }
.heat-legend { display: flex; align-items: center; gap: 6px; }
.heat-swatch { width: 20px; height: 10px; border-radius: 3px; background: linear-gradient(135deg, var(--accent), var(--accent-2)); opacity: calc(0.07 + var(--t, 0) * 0.93); }

/* ------------------------------------------------------------- waterfall -- */

.waterfall { animation: rise 0.6s var(--ease-out) backwards; }
.waterfall-plot { position: relative; height: 100%; border-bottom: 1px solid var(--line); }
.waterfall-grid { position: absolute; left: 0; right: 0; height: 1px; background: var(--line-soft); }
.waterfall-col { position: absolute; top: 0; bottom: 0; transform: translateX(-50%); }
.waterfall-bar {
  position: absolute; left: 0; right: 0; border-radius: 6px;
  background: linear-gradient(180deg, var(--c2), var(--accent));
  box-shadow: 0 0 20px -8px var(--accent);
}
.waterfall-out .waterfall-bar { background: linear-gradient(180deg, var(--c5), var(--c7)); box-shadow: 0 0 20px -8px var(--c7); }
.waterfall-total .waterfall-bar { background: linear-gradient(180deg, var(--good), var(--accent-2)); box-shadow: 0 0 22px -8px var(--good); }
.waterfall-label {
  position: absolute; bottom: calc(100% + 6px); left: 50%; transform: translateX(-50%);
  font-style: normal; font-family: var(--mono); font-size: 10.5px; color: var(--text-2); white-space: nowrap;
}
.waterfall-name {
  position: absolute; top: calc(100% + 8px); left: 50%; transform: translateX(-50%);
  font-size: 10.5px; color: var(--muted); white-space: nowrap;
}

/* -------------------------------------------------- stacked columns/bars -- */

.stack-chart { display: grid; gap: 9px; animation: rise 0.6s var(--ease-out) backwards; }
.stack-plot { position: relative; border-bottom: 1px solid var(--line); }
.stack-gridline { position: absolute; left: 0; right: 0; height: 1px; background: var(--line-soft); }
.stack-gridline .axis { position: absolute; left: 2px; bottom: 2px; font-size: 10px; font-family: var(--mono); color: var(--muted); }
.stack-col { position: absolute; bottom: 0; top: 0; display: flex; align-items: flex-end; justify-content: center; padding: 0 3px; }
.stack-fill {
  width: 100%; max-width: 54px; height: 0; display: flex; flex-direction: column-reverse;
  border-radius: 7px 7px 0 0; overflow: hidden; transform-origin: bottom;
  transition: filter 0.25s var(--ease-soft), box-shadow 0.25s var(--ease-soft);
}
.stack-fill.active { filter: brightness(1.16); box-shadow: 0 0 22px -6px var(--accent); }
.stack-seg { display: block; width: 100%; transition: height 0.5s var(--ease-out); }
.stack-in { background: linear-gradient(180deg, var(--c2), var(--accent)); }
.stack-out { background: linear-gradient(180deg, var(--c5), var(--c7)); }
.stack-axis { display: flex; font-size: 10px; color: var(--muted); }
.stack-axis-label { flex: 1 1 0; text-align: center; white-space: nowrap; overflow: hidden; }
.stack-foot { display: flex; justify-content: space-between; gap: 12px; align-items: center; flex-wrap: wrap; }
.stack-readout { font-size: 12px; min-height: 17px; font-variant-numeric: tabular-nums; }

.minibars { display: grid; gap: 9px; animation: rise 0.6s var(--ease-out) backwards; }
.minibars-readout { font-size: 12.5px; min-height: 17px; }
.minibars-plot { display: flex; align-items: flex-end; gap: 3px; }
.minibar {
  flex: 1 1 0; height: 100%; display: flex; align-items: flex-end; cursor: pointer;
  border-radius: 4px 4px 0 0; overflow: hidden;
}
.minibar > i {
  display: block; width: 100%; border-radius: 4px 4px 0 0;
  background: linear-gradient(180deg, var(--accent-2), var(--accent));
  transition: filter 0.25s var(--ease-soft);
}
.minibar:hover > i, .minibar.active > i { filter: brightness(1.28); box-shadow: 0 0 16px -3px var(--accent-2); }
.minibars-axis { display: flex; gap: 3px; font-size: 9.5px; color: var(--muted); }
.minibars-axis > span { flex: 1 1 0; text-align: center; }

/* --------------------------------------------------------- modern motion -- */

/* Pointer-tracked spotlight on cards (hover-capable devices only). */
@media (hover: hover) and (pointer: fine) {
  .card { --mx: 50%; --my: 0%; }
  .card::after {
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: radial-gradient(340px circle at var(--mx) var(--my), var(--accent-soft), transparent 62%);
    opacity: 0; transition: opacity 0.4s var(--ease-soft);
  }
  .card:hover::after { opacity: 1; }
}

/* Slowly rotating gradient border for hero cards. */
.card-hero::before {
  /* overrides .card::before (which paints a 1px top hairline) */
  content: ''; position: absolute; inset: -2px; width: auto; height: auto; z-index: -2; border-radius: inherit;
  background: conic-gradient(from var(--spin), var(--c1), var(--c2), var(--c3), var(--c4), var(--c1));
  filter: blur(15px); opacity: 0.32; animation: border-spin 16s linear infinite;
}
@keyframes border-spin { to { --spin: 360deg; } }

.reveal {
  opacity: 0; transform: translateY(18px);
  transition: opacity 0.75s var(--ease-out), transform 0.75s var(--ease-out);
  transition-delay: calc(var(--i, 0) * 70ms);
}
.reveal.is-visible { opacity: 1; transform: none; }

/* Hero split: gauge beside its dimension meters. */
.health-split { display: grid; grid-template-columns: minmax(220px, 300px) 1fr; gap: 26px; align-items: center; }
.health-aside { display: grid; gap: 10px; justify-items: center; text-align: center; }
.health-actions { display: grid; gap: 9px; }
.health-action {
  display: flex; gap: 11px; align-items: flex-start; padding: 11px 13px; border-radius: 12px;
  background: var(--tint); border: 1px solid var(--line-soft); text-decoration: none; color: inherit;
  transition: transform 0.28s var(--ease-out), border-color 0.28s var(--ease-soft), background 0.28s var(--ease-soft);
  animation: rise 0.55s var(--ease-out) backwards; animation-delay: calc(var(--i, 0) * 70ms);
}
.health-action:hover { transform: translateX(3px); border-color: var(--accent-line); background: var(--tint-strong); }
.health-action-dot { width: 9px; height: 9px; border-radius: 50%; margin-top: 5px; flex: none; background: var(--accent-2); box-shadow: 0 0 12px -1px currentColor; }
.health-action-danger .health-action-dot { background: var(--danger); color: var(--danger); }
.health-action-warn .health-action-dot { background: var(--warn); color: var(--warn); }
.health-action-info .health-action-dot { background: var(--accent-2); color: var(--accent-2); }
.health-action-copy { display: grid; gap: 2px; }
.health-action-copy strong { font-size: 12.5px; }
.health-action-copy span { font-size: 11.5px; color: var(--muted); }

.grid-3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 18px; }
.span-2 { grid-column: span 2; }

@media (max-width: 1080px) {
  .health-split { grid-template-columns: 1fr; }
  .span-2 { grid-column: auto; }
}

.chart-under { margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--line-soft); }

.health-strip { display: grid; grid-template-columns: auto 1fr; gap: 26px; align-items: center; }

@media (max-width: 900px) {
  .health-strip { grid-template-columns: 1fr; }
}

/* ==========================================================================
   Authentication — login screen, session card, access control, account panel
   ========================================================================== */

/* ------------------------------------------------------------- login ------ */

.boot {
  min-height: 100vh; position: relative; z-index: 1;
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16px;
  color: var(--text-2);
}
.boot-bar { width: 168px; height: 4px; border-radius: 99px; background: var(--tint-strong); overflow: hidden; }
.boot-bar i {
  display: block; height: 100%; width: 40%; border-radius: 99px;
  background: linear-gradient(90deg, var(--c1), var(--c2));
  animation: boot-slide 1.15s var(--ease-soft) infinite;
}
@keyframes boot-slide { from { transform: translateX(-110%); } to { transform: translateX(360%); } }

.login-screen {
  position: relative; z-index: 1; min-height: 100vh;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  gap: 22px; padding: 46px 22px;
}
/* A denser aurora than the app background, since this screen is all chrome. */
.login-aurora {
  position: fixed; inset: 0; z-index: -1; pointer-events: none;
  background:
    radial-gradient(760px 460px at 12% 8%, var(--glow-a), transparent 68%),
    radial-gradient(680px 420px at 88% 88%, var(--glow-b), transparent 70%),
    linear-gradient(160deg, var(--bg) 0%, var(--bg-2) 100%);
  opacity: var(--glow-opacity);
  animation: login-breathe 22s var(--ease-soft) infinite alternate;
}
@keyframes login-breathe { from { transform: scale(1); } to { transform: scale(1.05) translate3d(0, -1.5vh, 0); } }

.login-wrap {
  width: 100%; max-width: 980px;
  display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 22px; align-items: start;
}
.glass { backdrop-filter: blur(var(--glass-blur)); -webkit-backdrop-filter: blur(var(--glass-blur)); }
.login-card, .login-demo {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  box-shadow: var(--shadow-lg);
  backdrop-filter: blur(var(--glass-blur));
  -webkit-backdrop-filter: blur(var(--glass-blur));
  position: relative; overflow: hidden;
}
.login-card { padding: 30px; display: grid; gap: 20px; animation: rise 0.6s var(--ease-out) backwards; }
.login-card[data-shake] { animation: login-shake 0.42s var(--ease-soft); }
@keyframes login-shake {
  0%, 100% { transform: translateX(0); }
  20% { transform: translateX(-7px); }
  40% { transform: translateX(6px); }
  60% { transform: translateX(-4px); }
  80% { transform: translateX(2px); }
}
.login-card-glow {
  position: absolute; inset: -1px -1px auto; height: 180px; pointer-events: none;
  background: radial-gradient(420px 160px at 22% 0%, var(--accent-soft), transparent 72%);
}
.login-head { position: relative; }
.login-title { display: grid; gap: 6px; }
.login-title p { font-size: 13px; max-width: 42ch; }

.login-notice, .login-error, .login-lock, .app-notice {
  display: flex; align-items: center; gap: 10px;
  padding: 11px 13px; border-radius: 12px; font-size: 12.5px;
  border: 1px solid var(--line); background: var(--tint);
  animation: rise 0.4s var(--ease-out) backwards;
}
.login-notice { border-color: var(--accent-line); background: var(--accent-soft); color: var(--text-2); }
.login-error { border-color: rgba(251, 113, 133, 0.42); background: var(--danger-soft); color: var(--text); }
.login-error-icon {
  flex: none; width: 20px; height: 20px; border-radius: 50%; display: grid; place-items: center;
  background: var(--danger); color: #fff; font-weight: 800; font-size: 12px;
  box-shadow: 0 0 18px -4px var(--danger);
}
.login-error-copy { display: grid; gap: 2px; }
.login-error-copy strong { font-weight: 650; }
.login-error-copy span { color: var(--muted); }
.login-lock { border-color: rgba(251, 191, 36, 0.42); background: var(--warn-soft); color: var(--text); }
.login-lock strong { color: var(--warn); font-size: 14px; }

.login-form { display: grid; gap: 15px; }
.login-field { display: grid; gap: 7px; }
.login-label { font-size: 12.5px; font-weight: 600; color: var(--text-2); }
.login-input { position: relative; display: flex; align-items: center; }
.login-input-icon {
  position: absolute; left: 12px; font-size: 12px; color: var(--muted); pointer-events: none;
  transition: color 0.25s var(--ease-soft), transform 0.25s var(--ease-out);
}
.login-input:focus-within .login-input-icon { color: var(--accent-2); transform: scale(1.12); }
.login-input input { padding: 12px 14px 12px 38px; }
.login-input input[type='password'], .login-input input[type='text'] { padding-right: 62px; }
.login-reveal {
  position: absolute; right: 8px; border: 0; background: transparent; cursor: pointer;
  font: inherit; font-size: 11.5px; font-weight: 650; color: var(--accent-2);
  padding: 6px 8px; border-radius: 8px; transition: background 0.2s var(--ease-soft);
}
.login-reveal:hover { background: var(--accent-soft); }
.login-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
.login-hint { font-size: 11.5px; }
.login-submit { padding: 13px 16px; font-size: 14px; letter-spacing: 0.01em; }
.login-foot {
  display: flex; align-items: center; gap: 9px; padding-top: 15px; border-top: 1px solid var(--line-soft);
  font-size: 11.5px; color: var(--muted);
}
.login-sig { font-size: 11.5px; letter-spacing: 0.14em; text-transform: uppercase; }

/* --------------------------------------------- demo credential readout ---- */

.login-demo { padding: 22px; display: grid; gap: 13px; animation: rise 0.6s var(--ease-out) 0.08s backwards; }
.login-demo-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
.login-demo-blurb { font-size: 12px; }
.login-demo-list { display: grid; gap: 9px; }
.demo-row {
  display: grid; gap: 5px; padding: 11px 12px; border-radius: 13px;
  border: 1px solid var(--line-soft); background: var(--tint);
  transition: border-color 0.25s var(--ease-soft), background 0.25s var(--ease-soft), transform 0.25s var(--ease-out);
  animation: rise 0.5s var(--ease-out) backwards; animation-delay: calc(var(--i, 0) * 60ms);
}
.demo-row:hover { border-color: var(--accent-line); background: var(--tint-strong); }
.demo-fill {
  display: flex; align-items: center; gap: 11px; width: 100%; text-align: left;
  border: 0; background: none; font: inherit; color: inherit; cursor: pointer; padding: 0;
}
.demo-badge {
  flex: none; padding: 4px 9px; border-radius: 8px; font-size: 10.5px; font-weight: 750;
  letter-spacing: 0.07em; text-transform: uppercase;
  background: var(--accent-soft); color: var(--accent-2); border: 1px solid var(--accent-line);
}
.demo-role-admin .demo-badge { background: linear-gradient(120deg, var(--c1), var(--c2)); color: #fff; border-color: transparent; }
.demo-role-viewer .demo-badge { background: var(--tint-strong); color: var(--muted); border-color: var(--line); }
.demo-body { display: grid; gap: 1px; min-width: 0; }
.demo-email { font-size: 12.5px; color: var(--text); overflow-wrap: anywhere; }
.demo-name { font-size: 11px; color: var(--muted); }
.demo-secret { display: flex; align-items: center; gap: 8px; padding-left: 2px; }
.demo-password { font-size: 12.5px; color: var(--accent-2); letter-spacing: 0.04em; }
.demo-blurb { font-size: 11px; }
.demo-empty { font-size: 12px; text-align: center; }
.login-demo-foot { font-size: 11px; line-height: 1.55; }
.login-demo-foot strong { color: var(--text-2); }

/* ------------------------------------------------------ session in shell -- */

.session-card {
  display: flex; align-items: center; gap: 10px; width: 100%; text-align: left; cursor: pointer;
  border: 1px solid rgba(148, 163, 184, 0.14); background: rgba(255, 255, 255, 0.04);
  color: inherit; font: inherit; padding: 10px 11px; border-radius: 13px;
  position: relative; z-index: 1;
  transition: border-color 0.25s var(--ease-soft), background 0.25s var(--ease-soft), transform 0.25s var(--ease-out);
}
.session-card:hover { border-color: var(--accent-line); background: rgba(99, 102, 241, 0.14); transform: translateY(-1px); }
.session-copy { display: grid; gap: 1px; min-width: 0; }
.session-copy strong { font-size: 12.5px; color: #e8ecf8; }
.session-copy span { font-size: 10.5px; overflow-wrap: anywhere; }
.session-role {
  margin-left: auto; font-size: 10px; font-weight: 750; letter-spacing: 0.07em; text-transform: uppercase;
  padding: 3px 7px; border-radius: 7px; background: rgba(99, 102, 241, 0.24); color: #cdd6ff;
}
.avatar {
  flex: none; width: 34px; height: 34px; border-radius: 11px; display: grid; place-items: center;
  font-size: 12px; font-weight: 750; letter-spacing: 0.03em; color: #fff;
  background: linear-gradient(135deg, var(--c1), var(--c6));
  box-shadow: 0 8px 20px -10px var(--c1);
}
.avatar-operator { background: linear-gradient(135deg, var(--c2), var(--c4)); box-shadow: 0 8px 20px -10px var(--c2); }
.avatar-viewer { background: linear-gradient(135deg, #64748b, #334155); box-shadow: none; }
.row-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }

.role-note { display: inline-flex; align-items: center; gap: 8px; font-size: 12px; color: var(--muted); }

.app-notice {
  position: sticky; top: 0; z-index: 3; margin-bottom: 16px;
  border-color: var(--accent-line); background: var(--accent-soft); color: var(--text-2);
}

/* ------------------------------------------------------- access control ---- */

.admin-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(168px, 1fr)); gap: 14px; }
.admin-split { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 20px; align-items: start; }
.admin-table-wrap { overflow-x: auto; }
.admin-table { width: 100%; border-collapse: collapse; font-size: 12.5px; }
.admin-table th {
  text-align: left; padding: 10px 12px; font-size: 11px; text-transform: uppercase;
  letter-spacing: 0.08em; color: var(--muted); border-bottom: 1px solid var(--line);
}
.admin-table td { padding: 11px 12px; border-bottom: 1px solid var(--line-soft); vertical-align: middle; }
.admin-table tbody tr { transition: background 0.22s var(--ease-soft); }
.admin-table tbody tr:hover { background: var(--tint); }
.admin-row-self { background: var(--accent-soft); }
.admin-who { display: flex; align-items: center; gap: 10px; }
.admin-who-copy { display: grid; gap: 1px; }
.admin-who-copy strong { font-size: 12.5px; }
.admin-who-copy span { font-size: 10.5px; }
.admin-caps { font-size: 10.5px; margin-top: 4px; letter-spacing: 0.02em; }
.admin-actions { display: flex; gap: 7px; justify-content: flex-end; }
.admin-roles { display: grid; gap: 9px; padding: 16px 20px; border-top: 1px solid var(--line-soft); }
.admin-role-card {
  display: grid; grid-template-columns: auto 1fr auto; gap: 10px; align-items: center;
  padding: 10px 12px; border-radius: 12px; background: var(--tint); border: 1px solid var(--line-soft);
  font-size: 11.5px;
}
.admin-filter { margin-bottom: 13px; }
.admin-events-card .card-body { padding-bottom: 8px; }

.event-list { display: grid; gap: 3px; max-height: 520px; overflow-y: auto; }
.event-row {
  display: grid; grid-template-columns: auto 1fr auto; gap: 11px; align-items: center;
  padding: 9px 10px; border-radius: 11px; animation: rise 0.45s var(--ease-out) backwards;
  animation-delay: calc(var(--i, 0) * 30ms); transition: background 0.22s var(--ease-soft);
}
.event-row:hover { background: var(--tint); }
.event-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--muted); box-shadow: 0 0 12px -2px currentColor; }
.event-ok { background: var(--good); color: var(--good); }
.event-low { background: var(--warn); color: var(--warn); }
.event-out { background: var(--danger); color: var(--danger); }
.event-accent { background: var(--accent-2); color: var(--accent-2); }
.event-copy { display: grid; gap: 1px; font-size: 12px; min-width: 0; }
.event-copy strong { font-weight: 650; }
.event-copy span { font-size: 10.5px; overflow-wrap: anywhere; }
.event-meta { display: grid; gap: 1px; text-align: right; font-size: 10.5px; color: var(--muted); }

/* ------------------------------------------------------------- account ---- */

.account-id { display: flex; gap: 14px; align-items: flex-start; }
.account-id .avatar { width: 46px; height: 46px; border-radius: 14px; font-size: 15px; }
.account-id-copy { display: grid; gap: 3px; }
.account-id-copy strong { font-size: 15px; }
.account-meta { display: flex; align-items: center; gap: 8px; margin-top: 3px; font-size: 11.5px; flex-wrap: wrap; }
.account-facts {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px;
  margin: 18px 0; padding: 14px; border-radius: 13px; background: var(--tint); border: 1px solid var(--line-soft);
}
.account-facts dt { font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }
.account-facts dd { margin: 3px 0 0; font-size: 12.5px; font-weight: 600; }
.account-form { display: grid; gap: 13px; border-top: 1px solid var(--line-soft); padding-top: 16px; }
.account-form-foot { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }

.pw-meter { display: grid; gap: 5px; }
.pw-bars { display: flex; gap: 5px; }
.pw-bars i {
  height: 4px; flex: 1; border-radius: 99px; background: var(--tint-strong);
  transition: background 0.3s var(--ease-soft), box-shadow 0.3s var(--ease-soft);
}
.pw-meter[data-score='1'] .pw-bars i.on { background: var(--danger); box-shadow: 0 0 12px -3px var(--danger); }
.pw-meter[data-score='2'] .pw-bars i.on { background: var(--warn); box-shadow: 0 0 12px -3px var(--warn); }
.pw-meter[data-score='3'] .pw-bars i.on,
.pw-meter[data-score='4'] .pw-bars i.on { background: var(--good); box-shadow: 0 0 12px -3px var(--good); }

@media (max-width: 960px) {
  .login-wrap { grid-template-columns: minmax(0, 1fr); max-width: 520px; }
  .admin-split { grid-template-columns: minmax(0, 1fr); }
}

@media print {
  .login-screen, .boot, .session-card, .row-actions, .admin-actions { display: none !important; }
}

/* --------------------------------------------------------- PDF report ----- */

.head-actions { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }

.pdf-btn { display: inline-flex; align-items: center; gap: 8px; text-decoration: none; }
.pdf-btn-mark {
  flex: none; border-radius: 4px;
  transition: transform 0.35s var(--ease-out);
}
.pdf-btn:hover .pdf-btn-mark { transform: rotate(-6deg) scale(1.08); }

.pdf-note {
  display: flex; align-items: flex-start; gap: 9px; margin: 0 0 4px;
  font-size: 12px; line-height: 1.55; color: var(--muted);
  padding: 11px 13px; border-radius: 12px;
  background: var(--tint); border: 1px solid var(--line-soft);
}
.pdf-note .badge { flex: none; margin-top: 1px; }

@media print {
  .pdf-btn, .pdf-note { display: none !important; }
}

/* ------------------------------------------------------ product artwork --- */

.product-art, .product-photo { display: block; flex: none; }
.product-photo { object-fit: cover; background: var(--tint); border: 1px solid var(--line-soft); }
.product-art { filter: drop-shadow(0 6px 14px -8px rgba(6, 12, 30, 0.6)); }
.product-art text { font-family: "Inter", -apple-system, "Segoe UI", Roboto, sans-serif; }

.cell-product { display: flex; align-items: center; gap: 11px; min-width: 0; }
.cell-product-copy { display: grid; gap: 1px; min-width: 0; }

.view-switch { flex: none; }

/* Gallery view ------------------------------------------------------------- */

.product-grid {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(212px, 1fr));
  gap: 16px; padding: 18px;
}
.product-card {
  position: relative; display: grid; gap: 0; overflow: hidden;
  border: 1px solid var(--line); border-radius: 15px; background: var(--tint);
  animation: rise 0.5s var(--ease-out) backwards;
  transition: transform 0.3s var(--ease-out), border-color 0.3s var(--ease-soft), box-shadow 0.3s var(--ease-soft);
}
.product-card:hover {
  transform: translateY(-3px); border-color: var(--accent-line);
  box-shadow: 0 20px 40px -24px rgba(0, 0, 0, 0.8);
}
.product-card:hover .product-art { transform: scale(1.05) rotate(-1.5deg); }
.product-card-art {
  border: 0; padding: 0; background: none; cursor: pointer; display: block;
  line-height: 0; border-top-left-radius: 15px; border-top-right-radius: 15px; overflow: hidden;
}
.product-card-art .product-art { width: 100% !important; height: auto !important; aspect-ratio: 1 / 1; border-radius: 0; transition: transform 0.45s var(--ease-out); }
.product-card-art .product-photo { width: 100% !important; height: auto !important; aspect-ratio: 1 / 1; border-radius: 0; border: 0; }
.product-card-body { display: grid; gap: 4px; padding: 13px 14px 11px; }
.product-card-name { font-weight: 650; font-size: 13.5px; letter-spacing: -0.01em; }
.product-card-facts { font-size: 12.5px; }
.product-card-tags { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; margin-top: 5px; }
.product-card-actions { display: flex; gap: 8px; padding: 0 12px 12px; }

.image-field { display: flex; align-items: center; gap: 12px; }
.image-field > .product-art, .image-field > .product-photo { flex: none; }
.image-controls { display: grid; gap: 8px; flex: 1 1 auto; min-width: 0; }
.image-controls input[type="url"] { width: 100%; }
.image-actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.image-upload { position: relative; cursor: pointer; display: inline-flex; align-items: center; }
.image-upload:focus-within { outline: 2px solid var(--accent); outline-offset: 2px; }
/* Kept in the layout for the keyboard and for tests: the label is the visible
   control, the input carries the real file picking. */
.image-file {
  position: absolute; inset: 0; width: 100%; height: 100%;
  opacity: 0; cursor: pointer;
}
.image-file:disabled { cursor: progress; }
.image-field[data-photo="upload"] > .product-photo,
.image-field[data-photo="stored"] > .product-photo { box-shadow: 0 6px 18px rgba(3, 12, 34, 0.28); }

@media (max-width: 560px) {
  .image-field { align-items: flex-start; }
}

/* Detail hero ------------------------------------------------------------- */

.detail-hero {
  display: flex; gap: 18px; align-items: center; margin-bottom: 18px;
  padding: 16px; border-radius: 14px; background: var(--tint); border: 1px solid var(--line-soft);
}
.detail-hero-copy { display: grid; gap: 4px; min-width: 0; }
.detail-hero-title { font-size: 15px; font-weight: 700; letter-spacing: -0.01em; }
.detail-hero-tags { display: flex; align-items: center; gap: 9px; flex-wrap: wrap; margin-top: 2px; }

@media (max-width: 720px) {
  .detail-hero { flex-direction: column; align-items: flex-start; }
  .product-grid { grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); }
}

/* ==========================================================================
   Purchasing, suppliers and cycle counting
   ========================================================================== */

.stat-grid-4 { grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); }

/* Status tabs ------------------------------------------------------------- */
.tabs { display: flex; gap: 4px; flex-wrap: wrap; }
.tab {
  display: inline-flex; align-items: center; gap: 7px;
  padding: 7px 13px; border-radius: 9px; border: 1px solid transparent;
  background: transparent; color: var(--muted); font: inherit; font-size: 12.5px;
  font-weight: 600; cursor: pointer; transition: background 0.18s ease, color 0.18s ease;
}
.tab:hover { background: var(--tint); color: var(--ink); }
.tab.active { background: var(--accent-soft); color: var(--accent-2); border-color: var(--line-soft); }
.tab:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.tab-count {
  font-size: 11px; font-weight: 700; padding: 1px 6px; border-radius: 20px;
  background: var(--tint-strong); color: var(--muted);
}
.tab.active .tab-count { background: var(--accent-soft); color: var(--accent-2); }

/* Receipt progress -------------------------------------------------------- */
.progress {
  display: inline-block; vertical-align: middle; width: 64px; height: 6px;
  border-radius: 4px; background: var(--tint-strong); overflow: hidden;
}
.progress-fill {
  display: block; height: 100%; border-radius: 4px; background: var(--accent);
  transition: width 0.6s cubic-bezier(0.22, 1, 0.36, 1);
}
.progress-fill[data-tone="ok"] { background: var(--good); }
.progress-fill[data-tone="warn"] { background: var(--warn); }

/* Order / count status badges --------------------------------------------- */
.badge-draft { background: var(--tint-strong); color: var(--muted); }
.badge-ordered, .badge-open { background: var(--accent-soft); color: var(--accent-2); border-color: var(--line-soft); }
.badge-partial { background: var(--warn-soft); color: var(--warn); border-color: rgba(251, 191, 36, 0.32); }
.badge-received, .badge-posted { background: var(--good-soft); color: var(--good); border-color: rgba(52, 211, 153, 0.32); }
.badge-cancelled { background: var(--tint-strong); color: var(--muted); text-decoration: line-through; }

/* Rows dimmed when a record is archived or cancelled ----------------------- */
.row-dim td { opacity: 0.55; }

/* Replenishment: the row itself says how urgent it is --------------------- */
.table tr[data-state="order"] td { background: var(--warn-soft); }
.table tr[data-state="order"] td:first-child { box-shadow: inset 2px 0 0 var(--warn); }
.table tr[data-state="watch"] td { background: var(--tint); }
.table tr[data-state="order"]:hover td, .table tr[data-state="watch"]:hover td { background: var(--tint-strong); }

/* Count sheet: every row declares its own verdict ------------------------- */
.count-sheet tr[data-variance="match"] td { background: var(--good-soft); }
.count-sheet tr[data-variance="diff"] td { background: var(--warn-soft); }
.count-sheet tr[data-variance="todo"] td { opacity: 0.82; }
.count-sheet td .qty-input { width: 74px; }

@media (prefers-reduced-motion: reduce) {
  .progress-fill, .tab { transition: none; }
}

/* new procurement screens ----------------------------------------------------------- */

